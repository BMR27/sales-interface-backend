generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(VENDEDOR)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourCompletadoAt DateTime?

  tenantId Int?
  tenant   Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])

  leads            Lead[]
  ventas           Venta[]
  llamadas         Llamada[]
  tenantsAprobados Tenant[]  @relation("TenantAprobadoPor")
  leadsAsignados   Lead[]    @relation("LeadAsignadoPor")
  apiKeysCreadas   ApiKey[]  @relation("ApiKeyCreadaPor")
  notificaciones   Notificacion[]
  sesiones         Sesion[]
  grabaciones      GrabacionLlamada[]

  @@map("users")
  leadsDescartados Lead[] @relation("LeadDescartadoPor")
}

enum Rol {
  // Nivel plataforma: administra los espacios (empresas), no vive dentro de
  // ninguno. En pantalla se llama "Dueño de la plataforma".
  SUPER_ADMIN
  // Dueño de una empresa: acceso total dentro de su espacio. En pantalla se
  // llama "Super Administrador".
  ADMIN
  // Administrador de operacion: reparte leads, revisa ventas y mueve
  // inventario, pero no toca al equipo, ni las API keys, ni la
  // configuracion del espacio. En pantalla, "Administrador".
  ADMIN_OPERATIVO
  VENDEDOR
  PROVEEDOR_LEADS
  COORDINADOR
}

model Tenant {
  id              Int          @id @default(autoincrement())
  tipoPersona     TipoPersona
  razonSocial     String
  nombreComercial String?
  emailContacto   String
  telefono        String?
  status          TenantStatus @default(PENDIENTE)
  motivoRechazo   String?
  aprobadoPorId   Int?
  aprobadoPor     User?        @relation("TenantAprobadoPor", fields: [aprobadoPorId], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Branding / white-label por empresa. Todo nullable y opcional: una empresa sin
  // configurar nada de esto sigue funcionando exactamente igual que antes (fallback
  // al branding por defecto de la plataforma en el frontend).
  subdominio           String? @unique
  dominioPersonalizado String? @unique
  logoUrl              String?
  colorPrimario        String?
  colorSecundario      String?

  // Plan y estado de cobro, llevado a mano por el superadmin -- no hay
  // procesador de pagos conectado, es solo para que el superadmin sepa que
  // tanto cobra cada espacio y si esta al corriente.
  plan         String?
  montoMensual Float?
  proximoCobro DateTime?
  estadoCobro  EstadoCobro @default(AL_CORRIENTE)

  users         User[]                 @relation("TenantUsers")
  leads         Lead[]
  ventas        Venta[]
  prepagos      PrepagoGestion[]
  prepagoNotas  PrepagoNota[]
  apiKeys       ApiKey[]
  incomingLeads IncomingLead[]
  llamadas      Llamada[]
  productos     Producto[]
  movimientos   MovimientoInventario[]
  appSettings   AppSetting[]
  leadItems     LeadItem[]
  rolePermisos  RolePermiso[]
  auditLogs     AuditLog[]
  notificaciones Notificacion[]
  grabaciones   GrabacionLlamada[]

  @@map("tenants")
  folioContador   FolioContador?
}

enum TipoPersona {
  FISICA
  MORAL
}

enum TenantStatus {
  PENDIENTE
  ACTIVO
  RECHAZADO
  SUSPENDIDO
}

enum EstadoCobro {
  AL_CORRIENTE
  VENCIDO
}

model Lead {
  id         Int        @id @default(autoincrement())
  nombre     String
  apellido   String?
  edad       Int?
  telefono   String
  producto   String
  cantidad   Int        @default(1)
  hora       String?
  status     LeadStatus @default(NUEVO)
  // Folio del PROVEEDOR, tal como viene en el payload de la API. No es
  // unico ni lo controlamos nosotros.
  folio      String?
  // Folio interno, el que se usa para referirse a un lead por telefono o
  // por escrito: "PS-000123". El nombre del cliente no sirve para eso --
  // llega mal capturado desde el proveedor. Unico dentro del espacio, lo
  // genera src/lib/folios.js.
  folioPS    String?    @unique
  monto      Float?
  categoria  String?
  notas      String?
  // Nullable a proposito: con asignacion manual el lead entra sin vendedora
  // y espera en la cola del coordinador (ver src/lib/assignment.js).
  vendedorId Int?
  vendedor   User?      @relation(fields: [vendedorId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  source             LeadSource @default(MANUAL)
  country            String?
  city               String?
  ip                 String?
  state              String?
  zipCode            String?
  internalSku        String?
  externalSku        String?
  shippingStreet     String?
  shippingNumber     String?
  shippingReferences String?
  colonia            String?
  municipio          String?
  lat                Float?
  lng                Float?

  // Cobertura de FullVector para este domicilio: false = FC FV (Fuera de
  // Cobertura Full Vector), o sea que en ese CP no hay pago en efectivo
  // contra entrega y la venta tiene que cerrarse como prepago. null = aún
  // no se ha podido verificar (sin CP, o FullVector no respondió).
  //
  // Es un reflejo, no la regla: la clasificación vive en FullVector (ver
  // checkCoverage en src/lib/fullvector.js). Se vuelve a consultar en cada
  // llamada, así que cuando allá se habilite cobertura nacional estos
  // leads se reetiquetan solos.
  coberturaFv        Boolean?
  coberturaFvAt      DateTime?

  // Autoriza a un cliente sin sesión a compartir su ubicación desde
  // app/compartir-ubicacion/[token]/page.tsx (ver src/routes/public.js) --
  // el token es la única autorización, válido 24h desde que se generó.
  ubicacionToken        String?   @unique
  ubicacionSolicitadaAt DateTime?
  // Se llena solo cuando el cliente comparte desde el link del SMS. Es lo
  // que distingue esa ubicación del pin que la vendedora coloca a mano o
  // que sale de geocodificar la dirección escrita.
  ubicacionCompartidaAt DateTime?
  // Dirección más cercana que conoce HERE al punto compartido, como texto
  // para que la vendedora la confirme con el cliente. No se usa para
  // enviar: el número puede ser el del vecino (ver reverseGeocode.js).
  direccionSugerida     String?

  productoId       Int?
  productoCatalogo Producto? @relation(fields: [productoId], references: [id])

  fechaReagenda          DateTime?
  asignadoPorCoordinador Boolean   @default(false)
  // Coordinadora que repartio este lead. Es la que cobra los $12 de la venta
  // que salga de el (ver src/lib/comisiones.js); null cuando lo asigno el
  // reparto automatico y entonces el credito se divide entre las activas.
  asignadoPorId          Int?
  asignadoPor            User?     @relation("LeadAsignadoPor", fields: [asignadoPorId], references: [id])

  // Un lead que la vendedora devuelve a la cola al cerrar su turno porque el
  // cliente no contesto. Se guarda quien lo devolvio y por que para que la
  // coordinadora no lo reasigne a la misma persona ni repita el intento a
  // ciegas. El nombre va desnormalizado a proposito: es un dato historico
  // de ese momento, no una referencia viva al usuario.
  devueltoAt        DateTime?
  devueltoMotivo    String?
  devueltoPorNombre String?

  // Por que se descarto. Clave del catalogo de src/lib/motivosDescarte.js,
  // no texto libre: de aqui sale el porcentaje de calidad de la base que
  // manda el proveedor, y para medir hace falta un conjunto cerrado.
  // Null en los leads descartados antes de que existiera el catalogo.
  motivoDescarte    String?
  motivoDescarteNota String?
  descartadoAt      DateTime?
  descartadoPorId   Int?
  descartadoPor     User?     @relation("LeadDescartadoPor", fields: [descartadoPorId], references: [id])

  incomingLead IncomingLead?

  llamadas    Llamada[]
  venta       Venta?
  items       LeadItem[]
  grabaciones GrabacionLlamada[]

  @@index([tenantId, status])
  @@map("leads")
}

// Ciclo de vida de un lead (ver src/lib/leadStatus.js para etiquetas):
//   NUEVO      -> Nuevo ingreso: ingresado a sistema
//   REAGENDADO -> Re-Llamar: el cliente pide llamar otro día
//   DESCARTADO -> el cliente expresa que no lo quiere
//   VENTA      -> Concretado: venta aceptada por el cliente
enum LeadStatus {
  NUEVO
  REAGENDADO
  DESCARTADO
  VENTA
}

enum LeadSource {
  MANUAL
  EXTERNAL_API
}

model Venta {
  id             Int      @id @default(autoincrement())
  leadId         Int      @unique
  lead           Lead     @relation(fields: [leadId], references: [id])
  vendedorId     Int
  vendedor       User     @relation(fields: [vendedorId], references: [id])
  monto          Float
  comision       Float
  // Costo de envío cobrado al cliente (ver src/lib/shippingCost.js) --
  // separado de `monto` a propósito: la comisión del vendedor se calcula
  // solo sobre el producto, no sobre el flete. Lo que se cobra realmente
  // (y lo que se manda a FullVector como orderValue) es monto+costoEnvio.
  costoEnvio     Float    @default(0)
  folio          String?
  // Entrega realmente confirmada. Es la condición para pagar comisión (ver
  // src/lib/comisiones.js): hasta que alguien la confirma, la venta no suma
  // unidades. Antes se guardaba en true al cerrar la venta, así que no
  // distinguía nada.
  entregaExitosa Boolean  @default(false)
  entregaConfirmadaAt  DateTime?
  entregaConfirmadaPor String?
  // Cancelada o devuelta: resta sus unidades del acumulado de la quincena.
  cancelada       Boolean   @default(false)
  canceladaAt     DateTime?
  canceladaMotivo String?
  fecha          DateTime @default(now())
  createdAt      DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fullvectorSyncStatus FullvectorSyncStatus @default(PENDING)
  fullvectorOrderId    String?
  // La orden se creó en FullVector pero su CP está fuera de la cobertura
  // de mensajería (trackingStatus NO_COVERAGE): no hay pago en efectivo
  // contra entrega. Esta es la base "prepago" -- se les llama aparte, se
  // cobra por transferencia y el paquete sale por mensajería tradicional.
  fullvectorSinCobertura Boolean            @default(false)
  fullvectorError      String?
  fullvectorAttempts   Int                  @default(0)
  fullvectorSyncedAt   DateTime?

  prepago PrepagoGestion?

  @@map("ventas")
}

// Gestión aparte de una venta cuyo CP no tiene pago contra entrega. El flujo
// no es automático a propósito: alguien llama al cliente, le explica que en
// su zona la mensajería no cobra en efectivo, le ofrece transferencia y hasta
// que el dinero cae se manda el paquete por mensajería tradicional. Esta
// tabla es el expediente de esa gestión -- la venta en sí no cambia.
model PrepagoGestion {
  id      Int   @id @default(autoincrement())
  ventaId Int   @unique
  venta   Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  estado PrepagoEstado @default(PENDIENTE_CONTACTO)

  // Cobro por transferencia. `pagoMonto` se guarda aparte del monto de la
  // venta: el cliente puede depositar de más o de menos y lo que importa
  // para liberar el envío es lo que realmente cayó.
  pagoReferencia     String?
  pagoMonto          Float?
  pagoConfirmadoAt   DateTime?
  pagoConfirmadoPor  String?

  // Envío por fuera de FullVector.
  paqueteria String?
  guia       String?
  enviadoAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  notas PrepagoNota[]

  @@index([tenantId, estado])
  @@map("prepago_gestiones")
}

// Bitácora de contacto: cada intento de llamada a un cliente de prepago y en
// qué quedó. El nombre del autor va desnormalizado igual que en
// Lead.devueltoPorNombre -- es el dato histórico de ese momento.
model PrepagoNota {
  id        Int            @id @default(autoincrement())
  gestionId Int
  gestion   PrepagoGestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  nota         String
  autorId      Int?
  autorNombre  String
  createdAt    DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([gestionId])
  @@map("prepago_notas")
}

enum PrepagoEstado {
  PENDIENTE_CONTACTO
  TRANSFERENCIA_OFRECIDA
  PAGO_CONFIRMADO
  ENVIADO
  CANCELADO
}

enum FullvectorSyncStatus {
  PENDING
  SYNCED
  FAILED
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  label      String
  keyPrefix  String
  keyHash    String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdByUserId Int?
  createdByUser   User? @relation("ApiKeyCreadaPor", fields: [createdByUserId], references: [id])

  incomingLeads IncomingLead[]

  @@map("api_keys")
}

model IncomingLead {
  id           Int                @id @default(autoincrement())
  folio        String
  consumerName String
  phone        String
  country      String
  state        String?
  zipCode      String?
  category     String
  product      String
  internalSku  String?
  externalSku  String
  rawPayload   Json?
  status       IncomingLeadStatus @default(RECEIVED)
  errorMessage String?

  apiKeyId Int
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id])

  assignedLeadId     Int?  @unique
  assignedLead       Lead? @relation(fields: [assignedLeadId], references: [id])
  assignedVendedorId Int?

  createdAt DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("incoming_leads")
}

enum IncomingLeadStatus {
  RECEIVED
  ASSIGNED
  FAILED
}

model AppSetting {
  id       Int     @id @default(autoincrement())
  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  key      String
  value    String

  @@unique([tenantId, key])
  @@map("app_settings")
}

// Avisos dentro de la app (la campana), distintos de los correos que manda
// src/lib/notificaciones.js: estos son por persona y se leen en pantalla.
//
// `clave` es lo que evita que el mismo hito se avise dos veces: los avisos
// derivados (meta al 50%, bloque de comision cerrado, motivacion del dia) se
// recalculan en cada consulta, asi que se insertan con una clave unica por
// usuario y, si ya existe, no se vuelve a crear. Los avisos de evento (un
// lead recien asignado) van sin clave: cada uno es uno nuevo.
model Notificacion {
  id        Int                   @id @default(autoincrement())
  tenantId  Int?
  tenant    Tenant?               @relation(fields: [tenantId], references: [id])
  userId    Int
  user      User                  @relation(fields: [userId], references: [id])
  tipo      String
  categoria NotificacionCategoria @default(INFO)
  titulo    String
  mensaje   String
  enlace    String?
  clave     String?
  leidaAt   DateTime?
  createdAt DateTime              @default(now())

  @@unique([userId, clave])
  @@index([userId, createdAt])
  @@map("notificaciones")
}

enum NotificacionCategoria {
  INFO
  EXITO
  ALERTA
  MOTIVACION
  LOGRO
}

// Sesiones activas. Existen para poder exigir una sola sesion por usuario:
// el token lleva el id de la sesion (`sid`) y el middleware la revisa, de
// modo que revocar la fila invalida el token aunque todavia no expire.
model Sesion {
  id          String    @id
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  tenantId    Int?
  dispositivo String?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  motivo      String?

  @@index([userId, revokedAt])
  @@map("sesiones")
}

// Permisos granulares por rol dentro de un tenant. La ausencia de una fila
// para (tenantId, rol, clave) significa "permitido" -- asi no hay que
// sembrar nada para los tenants que ya existen.
model RolePermiso {
  id       Int     @id @default(autoincrement())
  tenantId Int
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  rol      Rol
  clave    String
  activo   Boolean @default(true)

  @@unique([tenantId, rol, clave])
  @@map("role_permisos")
}

// Consecutivo del folio interno, uno por espacio.
//
// Vive en su propia tabla y no se calcula con un max(folioPS): dos leads
// que entran al mismo tiempo leerian el mismo maximo y se pelearian el
// numero. Aqui el incremento y la lectura son la misma sentencia atomica
// (ver src/lib/folios.js).
model FolioContador {
  tenantId Int    @id
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  valor    Int    @default(0)

  @@map("folio_contadores")
}

model Producto {
  id           Int      @id @default(autoincrement())
  sku          String
  nombre       String
  producto     String
  linea        String?
  categoria    String?
  subcategoria String?
  presentacion String?
  capacidad    String?
  empaque      String?
  pvpRetail    Float?
  pvpLeadsCpa  Float?
  ofertas      String?
  ofertasTiers Json?
  beneficios   String?
  activo       Boolean  @default(true)
  stock        Int      @default(0)
  createdAt    DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  leads       Lead[]
  movimientos MovimientoInventario[]
  leadItems   LeadItem[]

  @@unique([tenantId, sku])
  @@map("productos")
}

model LeadItem {
  id             Int      @id @default(autoincrement())
  leadId         Int
  lead           Lead     @relation(fields: [leadId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int      @default(1)
  precioUnitario Float
  esRegalo       Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([leadId])
  @@map("lead_items")
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id])
  tipo            MovimientoTipo
  cantidad        Int
  stockResultante Int
  motivo          String?
  ventaId         Int?
  createdAt       DateTime       @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("movimientos_inventario")
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
}

model GeocodeCache {
  id        Int      @id @default(autoincrement())
  query     String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@map("geocode_cache")
}

model CodigoPostal {
  id               Int      @id @default(autoincrement())
  cp               String
  colonia          String
  tipoAsentamiento String?
  municipio        String?
  estado           String?
  ciudad           String?
  createdAt        DateTime @default(now())

  @@unique([cp, colonia])
  @@index([cp])
  @@map("codigos_postales")
}

// Historial de llamadas de un lead: cada fila es un INTENTO, contestado o no.
//
// Antes solo se escribia al confirmar una venta o reagendar, asi que los
// intentos donde nadie contesto no dejaban rastro y era imposible saber
// cuantas veces se habia llamado a alguien. Ahora la fila nace cuando se
// marca desde el panel (webhook de TwiML) y se completa en dos momentos:
// cuando Twilio avisa como termino la llamada (si contestaron y cuanto duro)
// y cuando la vendedora registra el resultado.
//
// Una llamada hecha fuera del marcador no tiene intento previo que
// completar, asi que registrar el resultado crea la fila: el historial
// prefiere un registro sin duracion a no registrar nada.
model Llamada {
  id         Int      @id @default(autoincrement())
  leadId     Int
  lead       Lead     @relation(fields: [leadId], references: [id])
  vendedorId Int
  vendedor   User     @relation(fields: [vendedorId], references: [id])
  duracion   Int?
  ofertas    String[]
  resultado  String?
  notas      String?
  fecha      DateTime @default(now())

  // Identifica el intento en Twilio y lo amarra con su grabacion.
  callSid String? @unique
  // Como termino la llamada segun Twilio: completed, no-answer, busy, failed.
  // null mientras no haya llegado el aviso (o si se marco fuera del panel).
  desenlace String?
  // Si el cliente llego a contestar. Es lo que separa "le llame 5 veces y
  // nunca contesto" de "hable con el 5 veces".
  contestada Boolean @default(false)

  // Estatus del lead antes y despues de este intento: es lo que permite
  // leer el historial como una historia ("estaba NUEVO, quedo REAGENDADO").
  estadoAntes   LeadStatus?
  estadoDespues LeadStatus?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([leadId, fecha])
  @@map("llamadas")
}

// Grabacion de una llamada, para que el admin pueda escucharla despues.
//
// El audio NO se guarda aqui: vive en Twilio y se sirve por proxy desde
// /api/admin/grabaciones/:id/audio, que es lo que permite exigir rol ADMIN
// y dejar constancia en el kardex de quien escucho que. Esta tabla es el
// indice: a que lead y a que vendedora corresponde cada grabacion.
//
// La fila nace en el webhook de TwiML (cuando arranca la llamada, con el
// CallSid) y se completa en el webhook de grabacion (con el RecordingSid y
// la duracion). Por eso `recordingSid` es opcional: entre un webhook y el
// otro la llamada esta en curso, y si nunca llega el segundo la fila queda
// como constancia de que esa llamada no dejo audio.
model GrabacionLlamada {
  id           Int       @id @default(autoincrement())
  callSid      String    @unique
  recordingSid String?   @unique
  estado       GrabacionEstado @default(EN_CURSO)
  duracion     Int?
  grabadaAt    DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  // Opcionales porque el webhook puede llegar sin poder resolverlos (un
  // lead borrado, un parametro manipulado): es preferible una grabacion
  // huerfana que perder el registro de que la llamada existio.
  leadId     Int?
  lead       Lead? @relation(fields: [leadId], references: [id])
  vendedorId Int?
  vendedor   User? @relation(fields: [vendedorId], references: [id])

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([leadId])
  @@map("grabaciones_llamadas")
}

enum GrabacionEstado {
  EN_CURSO
  COMPLETADA
  FALLIDA
  BORRADA
}

// Módulo de monitoreo (Admin): captura automática vía console.error
// interceptado (ver src/index.js + src/lib/errorLog.js), sin tocar cada
// ruta una por una.
model ErrorLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  method     String?
  path       String?
  statusCode Int?
  message    String
  stack      String?
  userId     Int?
  tenantId   Int?

  // Contexto de quien disparo el error (ver src/lib/requestContext.js).
  ip        String?
  userAgent String?
  origin    String?

  @@index([createdAt])
  @@map("error_logs")
}

// Latencia agregada en buckets de 5 min (ver src/jobs/monitoring.js) --
// no se guarda una fila por request, se acumula en memoria y se vacía
// periódicamente.
model RequestMetric {
  id              Int      @id @default(autoincrement())
  windowStart     DateTime
  route           String
  method          String
  count           Int      @default(0)
  totalDurationMs Int      @default(0)
  maxDurationMs   Int      @default(0)
  errorCount      Int      @default(0)

  @@unique([windowStart, route, method])
  @@index([windowStart])
  @@map("request_metrics")
}

// Kardex: bitácora de todo lo que pasa en el sistema (Admin). Se llena sola
// desde auditMiddleware (ver src/lib/auditoria.js), que registra cada request
// que modifica algo -- el mismo enfoque del módulo de monitoreo: no hay que
// acordarse de instrumentar cada ruta nueva.
//
// Los datos del usuario se guardan copiados, no por relación: el nombre o el
// correo pueden cambiar (o el usuario borrarse) y el kardex debe seguir
// diciendo quién hizo el movimiento con los datos de ese momento.
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  userId     Int?
  userNombre String?
  userEmail  String?
  userRol    String?

  // Qué pasó, en términos del negocio: accion "lead.crear", entidad "Lead".
  accion      String
  entidad     String?
  entidadId   String?
  descripcion String

  // Estado antes/después y sólo los campos que cambiaron, para poder ver el
  // detalle de un movimiento sin tener que deducirlo.
  antes   Json?
  despues Json?
  cambios Json?

  // Contexto técnico del movimiento.
  origen     String  @default("web") // web | api_externa | sistema
  metodo     String?
  ruta       String?
  statusCode Int?
  ip         String?
  userAgent  String?

  @@index([tenantId, createdAt])
  @@index([entidad, entidadId])
  @@index([userId])
  @@map("audit_logs")
}

model MemorySnapshot {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  rssMb       Float
  heapUsedMb  Float
  heapTotalMb Float
  freeMemMb   Float
  loadAvg1    Float

  @@index([createdAt])
  @@map("memory_snapshots")
}
