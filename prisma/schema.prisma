generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(VENDEDOR)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourCompletadoAt DateTime?

  tenantId Int?
  tenant   Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])

  leads            Lead[]
  ventas           Venta[]
  llamadas         Llamada[]
  tenantsAprobados Tenant[]  @relation("TenantAprobadoPor")
  leadsAsignados   Lead[]    @relation("LeadAsignadoPor")
  apiKeysCreadas   ApiKey[]  @relation("ApiKeyCreadaPor")

  @@map("users")
}

enum Rol {
  SUPER_ADMIN
  ADMIN
  VENDEDOR
  PROVEEDOR_LEADS
  COORDINADOR
}

model Tenant {
  id              Int          @id @default(autoincrement())
  tipoPersona     TipoPersona
  razonSocial     String
  nombreComercial String?
  emailContacto   String
  telefono        String?
  status          TenantStatus @default(PENDIENTE)
  motivoRechazo   String?
  aprobadoPorId   Int?
  aprobadoPor     User?        @relation("TenantAprobadoPor", fields: [aprobadoPorId], references: [id])
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Branding / white-label por empresa. Todo nullable y opcional: una empresa sin
  // configurar nada de esto sigue funcionando exactamente igual que antes (fallback
  // al branding por defecto de la plataforma en el frontend).
  subdominio           String? @unique
  dominioPersonalizado String? @unique
  logoUrl              String?
  colorPrimario        String?
  colorSecundario      String?

  // Plan y estado de cobro, llevado a mano por el superadmin -- no hay
  // procesador de pagos conectado, es solo para que el superadmin sepa que
  // tanto cobra cada espacio y si esta al corriente.
  plan         String?
  montoMensual Float?
  proximoCobro DateTime?
  estadoCobro  EstadoCobro @default(AL_CORRIENTE)

  users         User[]                 @relation("TenantUsers")
  leads         Lead[]
  ventas        Venta[]
  prepagos      PrepagoGestion[]
  prepagoNotas  PrepagoNota[]
  apiKeys       ApiKey[]
  incomingLeads IncomingLead[]
  llamadas      Llamada[]
  productos     Producto[]
  movimientos   MovimientoInventario[]
  appSettings   AppSetting[]
  leadItems     LeadItem[]
  rolePermisos  RolePermiso[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

enum TipoPersona {
  FISICA
  MORAL
}

enum TenantStatus {
  PENDIENTE
  ACTIVO
  RECHAZADO
  SUSPENDIDO
}

enum EstadoCobro {
  AL_CORRIENTE
  VENCIDO
}

model Lead {
  id         Int        @id @default(autoincrement())
  nombre     String
  apellido   String?
  edad       Int?
  telefono   String
  producto   String
  cantidad   Int        @default(1)
  hora       String?
  status     LeadStatus @default(NUEVO)
  folio      String?
  monto      Float?
  categoria  String?
  notas      String?
  // Nullable a proposito: con asignacion manual el lead entra sin vendedora
  // y espera en la cola del coordinador (ver src/lib/assignment.js).
  vendedorId Int?
  vendedor   User?      @relation(fields: [vendedorId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  source             LeadSource @default(MANUAL)
  country            String?
  city               String?
  ip                 String?
  state              String?
  zipCode            String?
  internalSku        String?
  externalSku        String?
  shippingStreet     String?
  shippingNumber     String?
  shippingReferences String?
  colonia            String?
  municipio          String?
  lat                Float?
  lng                Float?

  // Autoriza a un cliente sin sesión a compartir su ubicación desde
  // app/compartir-ubicacion/[token]/page.tsx (ver src/routes/public.js) --
  // el token es la única autorización, válido 24h desde que se generó.
  ubicacionToken        String?   @unique
  ubicacionSolicitadaAt DateTime?
  // Se llena solo cuando el cliente comparte desde el link del SMS. Es lo
  // que distingue esa ubicación del pin que la vendedora coloca a mano o
  // que sale de geocodificar la dirección escrita.
  ubicacionCompartidaAt DateTime?
  // Dirección más cercana que conoce HERE al punto compartido, como texto
  // para que la vendedora la confirme con el cliente. No se usa para
  // enviar: el número puede ser el del vecino (ver reverseGeocode.js).
  direccionSugerida     String?

  productoId       Int?
  productoCatalogo Producto? @relation(fields: [productoId], references: [id])

  fechaReagenda          DateTime?
  asignadoPorCoordinador Boolean   @default(false)
  // Coordinadora que repartio este lead. Es la que cobra los $12 de la venta
  // que salga de el (ver src/lib/comisiones.js); null cuando lo asigno el
  // reparto automatico y entonces el credito se divide entre las activas.
  asignadoPorId          Int?
  asignadoPor            User?     @relation("LeadAsignadoPor", fields: [asignadoPorId], references: [id])

  // Un lead que la vendedora devuelve a la cola al cerrar su turno porque el
  // cliente no contesto. Se guarda quien lo devolvio y por que para que la
  // coordinadora no lo reasigne a la misma persona ni repita el intento a
  // ciegas. El nombre va desnormalizado a proposito: es un dato historico
  // de ese momento, no una referencia viva al usuario.
  devueltoAt        DateTime?
  devueltoMotivo    String?
  devueltoPorNombre String?

  incomingLead IncomingLead?

  llamadas Llamada[]
  venta    Venta?
  items    LeadItem[]

  @@index([tenantId, status])
  @@map("leads")
}

// Ciclo de vida de un lead (ver src/lib/leadStatus.js para etiquetas):
//   NUEVO      -> Nuevo ingreso: ingresado a sistema
//   REAGENDADO -> Re-Llamar: el cliente pide llamar otro día
//   DESCARTADO -> el cliente expresa que no lo quiere
//   VENTA      -> Concretado: venta aceptada por el cliente
enum LeadStatus {
  NUEVO
  REAGENDADO
  DESCARTADO
  VENTA
}

enum LeadSource {
  MANUAL
  EXTERNAL_API
}

model Venta {
  id             Int      @id @default(autoincrement())
  leadId         Int      @unique
  lead           Lead     @relation(fields: [leadId], references: [id])
  vendedorId     Int
  vendedor       User     @relation(fields: [vendedorId], references: [id])
  monto          Float
  comision       Float
  // Costo de envío cobrado al cliente (ver src/lib/shippingCost.js) --
  // separado de `monto` a propósito: la comisión del vendedor se calcula
  // solo sobre el producto, no sobre el flete. Lo que se cobra realmente
  // (y lo que se manda a FullVector como orderValue) es monto+costoEnvio.
  costoEnvio     Float    @default(0)
  folio          String?
  // Entrega realmente confirmada. Es la condición para pagar comisión (ver
  // src/lib/comisiones.js): hasta que alguien la confirma, la venta no suma
  // unidades. Antes se guardaba en true al cerrar la venta, así que no
  // distinguía nada.
  entregaExitosa Boolean  @default(false)
  entregaConfirmadaAt  DateTime?
  entregaConfirmadaPor String?
  // Cancelada o devuelta: resta sus unidades del acumulado de la quincena.
  cancelada       Boolean   @default(false)
  canceladaAt     DateTime?
  canceladaMotivo String?
  fecha          DateTime @default(now())
  createdAt      DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fullvectorSyncStatus FullvectorSyncStatus @default(PENDING)
  fullvectorOrderId    String?
  // La orden se creó en FullVector pero su CP está fuera de la cobertura
  // de mensajería (trackingStatus NO_COVERAGE): no hay pago en efectivo
  // contra entrega. Esta es la base "prepago" -- se les llama aparte, se
  // cobra por transferencia y el paquete sale por mensajería tradicional.
  fullvectorSinCobertura Boolean            @default(false)
  fullvectorError      String?
  fullvectorAttempts   Int                  @default(0)
  fullvectorSyncedAt   DateTime?

  prepago PrepagoGestion?

  @@map("ventas")
}

// Gestión aparte de una venta cuyo CP no tiene pago contra entrega. El flujo
// no es automático a propósito: alguien llama al cliente, le explica que en
// su zona la mensajería no cobra en efectivo, le ofrece transferencia y hasta
// que el dinero cae se manda el paquete por mensajería tradicional. Esta
// tabla es el expediente de esa gestión -- la venta en sí no cambia.
model PrepagoGestion {
  id      Int   @id @default(autoincrement())
  ventaId Int   @unique
  venta   Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  estado PrepagoEstado @default(PENDIENTE_CONTACTO)

  // Cobro por transferencia. `pagoMonto` se guarda aparte del monto de la
  // venta: el cliente puede depositar de más o de menos y lo que importa
  // para liberar el envío es lo que realmente cayó.
  pagoReferencia     String?
  pagoMonto          Float?
  pagoConfirmadoAt   DateTime?
  pagoConfirmadoPor  String?

  // Envío por fuera de FullVector.
  paqueteria String?
  guia       String?
  enviadoAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  notas PrepagoNota[]

  @@index([tenantId, estado])
  @@map("prepago_gestiones")
}

// Bitácora de contacto: cada intento de llamada a un cliente de prepago y en
// qué quedó. El nombre del autor va desnormalizado igual que en
// Lead.devueltoPorNombre -- es el dato histórico de ese momento.
model PrepagoNota {
  id        Int            @id @default(autoincrement())
  gestionId Int
  gestion   PrepagoGestion @relation(fields: [gestionId], references: [id], onDelete: Cascade)

  nota         String
  autorId      Int?
  autorNombre  String
  createdAt    DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([gestionId])
  @@map("prepago_notas")
}

enum PrepagoEstado {
  PENDIENTE_CONTACTO
  TRANSFERENCIA_OFRECIDA
  PAGO_CONFIRMADO
  ENVIADO
  CANCELADO
}

enum FullvectorSyncStatus {
  PENDING
  SYNCED
  FAILED
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  label      String
  keyPrefix  String
  keyHash    String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdByUserId Int?
  createdByUser   User? @relation("ApiKeyCreadaPor", fields: [createdByUserId], references: [id])

  incomingLeads IncomingLead[]

  @@map("api_keys")
}

model IncomingLead {
  id           Int                @id @default(autoincrement())
  folio        String
  consumerName String
  phone        String
  country      String
  state        String?
  zipCode      String?
  category     String
  product      String
  internalSku  String?
  externalSku  String
  rawPayload   Json?
  status       IncomingLeadStatus @default(RECEIVED)
  errorMessage String?

  apiKeyId Int
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id])

  assignedLeadId     Int?  @unique
  assignedLead       Lead? @relation(fields: [assignedLeadId], references: [id])
  assignedVendedorId Int?

  createdAt DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("incoming_leads")
}

enum IncomingLeadStatus {
  RECEIVED
  ASSIGNED
  FAILED
}

model AppSetting {
  id       Int     @id @default(autoincrement())
  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  key      String
  value    String

  @@unique([tenantId, key])
  @@map("app_settings")
}

// Permisos granulares por rol dentro de un tenant. La ausencia de una fila
// para (tenantId, rol, clave) significa "permitido" -- asi no hay que
// sembrar nada para los tenants que ya existen.
model RolePermiso {
  id       Int     @id @default(autoincrement())
  tenantId Int
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  rol      Rol
  clave    String
  activo   Boolean @default(true)

  @@unique([tenantId, rol, clave])
  @@map("role_permisos")
}

model Producto {
  id           Int      @id @default(autoincrement())
  sku          String
  nombre       String
  producto     String
  linea        String?
  categoria    String?
  subcategoria String?
  presentacion String?
  capacidad    String?
  empaque      String?
  pvpRetail    Float?
  pvpLeadsCpa  Float?
  ofertas      String?
  ofertasTiers Json?
  beneficios   String?
  activo       Boolean  @default(true)
  stock        Int      @default(0)
  createdAt    DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  leads       Lead[]
  movimientos MovimientoInventario[]
  leadItems   LeadItem[]

  @@unique([tenantId, sku])
  @@map("productos")
}

model LeadItem {
  id             Int      @id @default(autoincrement())
  leadId         Int
  lead           Lead     @relation(fields: [leadId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int      @default(1)
  precioUnitario Float
  esRegalo       Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([leadId])
  @@map("lead_items")
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id])
  tipo            MovimientoTipo
  cantidad        Int
  stockResultante Int
  motivo          String?
  ventaId         Int?
  createdAt       DateTime       @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("movimientos_inventario")
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
}

model GeocodeCache {
  id        Int      @id @default(autoincrement())
  query     String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@map("geocode_cache")
}

model CodigoPostal {
  id               Int      @id @default(autoincrement())
  cp               String
  colonia          String
  tipoAsentamiento String?
  municipio        String?
  estado           String?
  ciudad           String?
  createdAt        DateTime @default(now())

  @@unique([cp, colonia])
  @@index([cp])
  @@map("codigos_postales")
}

model Llamada {
  id         Int      @id @default(autoincrement())
  leadId     Int
  lead       Lead     @relation(fields: [leadId], references: [id])
  vendedorId Int
  vendedor   User     @relation(fields: [vendedorId], references: [id])
  duracion   Int?
  ofertas    String[]
  resultado  String?
  notas      String?
  fecha      DateTime @default(now())

  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@map("llamadas")
}

// Módulo de monitoreo (Admin): captura automática vía console.error
// interceptado (ver src/index.js + src/lib/errorLog.js), sin tocar cada
// ruta una por una.
model ErrorLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  method     String?
  path       String?
  statusCode Int?
  message    String
  stack      String?
  userId     Int?
  tenantId   Int?

  // Contexto de quien disparo el error (ver src/lib/requestContext.js).
  ip        String?
  userAgent String?
  origin    String?

  @@index([createdAt])
  @@map("error_logs")
}

// Latencia agregada en buckets de 5 min (ver src/jobs/monitoring.js) --
// no se guarda una fila por request, se acumula en memoria y se vacía
// periódicamente.
model RequestMetric {
  id              Int      @id @default(autoincrement())
  windowStart     DateTime
  route           String
  method          String
  count           Int      @default(0)
  totalDurationMs Int      @default(0)
  maxDurationMs   Int      @default(0)
  errorCount      Int      @default(0)

  @@unique([windowStart, route, method])
  @@index([windowStart])
  @@map("request_metrics")
}

// Kardex: bitácora de todo lo que pasa en el sistema (Admin). Se llena sola
// desde auditMiddleware (ver src/lib/auditoria.js), que registra cada request
// que modifica algo -- el mismo enfoque del módulo de monitoreo: no hay que
// acordarse de instrumentar cada ruta nueva.
//
// Los datos del usuario se guardan copiados, no por relación: el nombre o el
// correo pueden cambiar (o el usuario borrarse) y el kardex debe seguir
// diciendo quién hizo el movimiento con los datos de ese momento.
model AuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  userId     Int?
  userNombre String?
  userEmail  String?
  userRol    String?

  // Qué pasó, en términos del negocio: accion "lead.crear", entidad "Lead".
  accion      String
  entidad     String?
  entidadId   String?
  descripcion String

  // Estado antes/después y sólo los campos que cambiaron, para poder ver el
  // detalle de un movimiento sin tener que deducirlo.
  antes   Json?
  despues Json?
  cambios Json?

  // Contexto técnico del movimiento.
  origen     String  @default("web") // web | api_externa | sistema
  metodo     String?
  ruta       String?
  statusCode Int?
  ip         String?
  userAgent  String?

  @@index([tenantId, createdAt])
  @@index([entidad, entidadId])
  @@index([userId])
  @@map("audit_logs")
}

model MemorySnapshot {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  rssMb       Float
  heapUsedMb  Float
  heapTotalMb Float
  freeMemMb   Float
  loadAvg1    Float

  @@index([createdAt])
  @@map("memory_snapshots")
}
